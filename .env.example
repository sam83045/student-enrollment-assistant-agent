# Copy to .env and adjust. Any OpenAI-compatible endpoint works.

# Local development (default): LM Studio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen_qwen3.5-4b
OPENAI_API_KEY=lm-studio

# OpenAI API (official demo log)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Ollama (fallback)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# OPENAI_API_KEY=ollama

# Max model calls per user turn before escalating
AGENT_MAX_ITERATIONS=5

# Docker Compose only: LLM endpoint as seen from inside the containers.
# Default: LM Studio on the host (http://host.docker.internal:1234/v1).
# DOCKER_LLM_BASE_URL=https://api.openai.com/v1
